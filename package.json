{
  "name": "arena-agent-motion-video",
  "version": "1.0.0",
  "private": true,
  "description": "فيديو موشن جرافيك تعريفي بالوكيل الذكي — مبني بـ Remotion + React (فيديو من الكود)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ArenaAgentVideo out/arena-agent.mp4",
    "render:sandbox": "node scripts/render-sandbox.mjs",
    "still": "remotion still src/index.ts ArenaAgentVideo out/poster.png --frame=90",
    "typecheck": "tsc --noEmit",
    "browser:ensure": "remotion browser ensure"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.5",
    "@fontsource/tajawal": "^5.2.5",
    "@remotion/fonts": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/layout-utils": "4.0.539",
    "@remotion/paths": "4.0.539",
    "@remotion/shapes": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.539",
    "@sparticuz/chromium": "^138.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "typescript": "^5.8.3"
  }
}
